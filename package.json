{
  "name": "js2coffee",
  "version": "2.2.0",
  "description": "JavaScript to CoffeeScript compiler",
  "homepage": "http://js2.coffee",
  "main": "dist/js2coffee.js",
  "keywords": [
    "javascript",
    "coffeescript",
    "language",
    "compiler",
    "es6",
    "es2015",
    "esnext",
    "transpiler"
  ],
  "scripts": {
    "test": "node --require coffeescript/register --test 'test/**/*.coffee'",
    "prepublish": "npm test && make -B dist"
  },
  "author": "Rico Sta. Cruz <hi@ricostacruz.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/js2coffee/js2coffee/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thatsnice/js2coffee.git"
  },
  "browser": "js2coffee.coffee",
  "bin": {
    "js2coffee": "./bin/js2coffee"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "escodegen": "^1.6.0",
    "esprima": "^2.5.0",
    "estraverse": "^4.1.1",
    "minimist": "^1.1.0",
    "read-input": "^0.3.1",
    "source-map": "^0.5.2"
  },
  "devDependencies": {
    "browserify": "13.3.0",
    "coffeescript": "^2.7.0",
    "coffeeify": "^3.0.1",
    "coffeelint": "^1.6.0",
    "glob": "^7.0.0",
    "js-yaml": "^3.2.1",
    "terser": "^5.36.0",
    "underscore": "^1.7.0"
  }
}
